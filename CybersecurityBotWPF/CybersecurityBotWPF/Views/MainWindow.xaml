 <Window x:Class="CybersecurityBotWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="750" Width="960"
        MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        FontFamily="Consolas"><Window.Resources>

    <!-- Colours -->
    <SolidColorBrush x:Key="BgDark"       Color="#0D1117"/>
    <SolidColorBrush x:Key="BgMid"        Color="#161B22"/>
    <SolidColorBrush x:Key="BgPanel"      Color="#1E2730"/>
    <SolidColorBrush x:Key="BgBubbleBot"  Color="#1A2435"/>
    <SolidColorBrush x:Key="BgBubbleUser" Color="#0F2A3D"/>
    <SolidColorBrush x:Key="AccentCyan"   Color="#00D2D3"/>
    <SolidColorBrush x:Key="AccentGreen"  Color="#38D39F"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#FFD54F"/>
    <SolidColorBrush x:Key="TextWhite"    Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextGray"     Color="#8B949E"/>
    <SolidColorBrush x:Key="BorderColor"  Color="#30363D"/>

    <!-- Send Button -->
    <Style x:Key="CyberButton" TargetType="Button">
        <Setter Property="Background"      Value="#00D2D3"/>
        <Setter Property="Foreground"      Value="#0D1117"/>
        <Setter Property="FontFamily"      Value="Consolas"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Height"          Value="42"/>
        <Setter Property="Padding"         Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#00AAAB"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#007F80"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Clear Button -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
        <Setter Property="Background" Value="#1E2730"/>
        <Setter Property="Foreground" Value="#8B949E"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2D3741"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--Input TextBox -->
    <Style x:Key="ChatInput" TargetType="TextBox">
        <Setter Property="Background"             Value="#161B22"/>
        <Setter Property="Foreground"             Value="#E6EDF3"/>
        <Setter Property="FontFamily"             Value="Consolas"/>
        <Setter Property="FontSize"               Value="13"/>
        <Setter Property="BorderThickness"        Value="1"/>
        <Setter Property="BorderBrush"            Value="#30363D"/>
        <Setter Property="CaretBrush"             Value="#00D2D3"/>
        <Setter Property="Height"                 Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#00D2D3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</Window.Resources>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- HEADER  -->
    <Border Grid.Row="0"
                Background="#161B22"
                BorderBrush="#30363D"
                BorderThickness="0,0,0,1"
                Padding="16,14">
        <StackPanel>

            <!-- ASCII Logo using xml:space="preserve" — safe, no CDATA needed -->
            <TextBlock xml:space="preserve"
                           FontFamily="Consolas"
                           FontSize="8"
                           FontWeight="Bold"
                           Foreground="#00D2D3"
                           TextAlignment="Center"
                           LineHeight="12">  @@@@@@  @@   @@  @@@@@@  @@@@@@@@  @@@@@@     @@@@@@   @@@@@@  @@@@@@@@
 @@       @@   @@  @@  @@  @@        @@  @@     @@  @@  @@   @@     @@
 @@        @@@@@   @@@@@@  @@@@@     @@@@@@     @@@@@@  @@   @@     @@
 @@         @@@    @@  @@  @@        @@  @@     @@  @@  @@   @@     @@
  @@@@@@     @    @@@@@@  @@@@@@@@  @@   @@    @@@@@@    @@@@@@     @@</TextBlock>

            <!-- Subtitle -->
            <Border Background="#0D1117"
                        CornerRadius="4"
                        Margin="0,10,0,0"
                        Padding="12,6">
                <TextBlock Text="[  Cybersecurity Awareness Bot  |  Keeping You Safe Online  ]"
                               Foreground="#38D39F"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
            </Border>

        </StackPanel>
    </Border>

    <!-- STATUS BAR -->
    <Border Grid.Row="1"
                Background="#0A0F14"
                BorderBrush="#30363D"
                BorderThickness="0,0,0,1"
                Padding="16,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusLabel"
                           Grid.Column="0"
                           Text="[ONLINE]  Type your message and press Enter or Send"
                           Foreground="#38D39F"
                           FontFamily="Consolas"
                           FontSize="10"
                           VerticalAlignment="Center"/>

            <TextBlock x:Name="MoodLabel"
                           Grid.Column="1"
                           Text=""
                           Foreground="#FFD54F"
                           FontFamily="Consolas"
                           FontSize="10"
                           VerticalAlignment="Center"/>
        </Grid>
    </Border>

    <!-- CHAT AREA -->
    <ScrollViewer Grid.Row="2"
                      x:Name="ChatScroller"
                      Background="#0D1117"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,8">
        <StackPanel x:Name="ChatPanel" Margin="4,0"/>
    </ScrollViewer>

    <!-- SENTIMENT INDICATOR -->
    <Border Grid.Row="3"
                x:Name="SentimentBar"
                Background="#0A0F14"
                BorderBrush="#30363D"
                BorderThickness="0,1,0,0"
                Padding="16,6"
                Visibility="Collapsed">
        <TextBlock x:Name="SentimentText"
                       Foreground="#00D2D3"
                       FontFamily="Consolas"
                       FontSize="10"
                       FontStyle="Italic"
                       Text=""/>
    </Border>

    <!-- INPUT PANEL  -->
    <Border Grid.Row="4"
                Background="#1E2730"
                BorderBrush="#30363D"
                BorderThickness="0,1,0,0"
                Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Style="{StaticResource ChatInput}"
                         KeyDown="InputBox_KeyDown"/>

            <Button Grid.Column="2"
                        x:Name="SendButton"
                        Style="{StaticResource CyberButton}"
                        Content="Send"
                        Width="90"
                        Click="SendButton_Click"/>

            <Button Grid.Column="4"
                        x:Name="ClearButton"
                        Style="{StaticResource GhostButton}"
                        Content="Clear"
                        Width="70"
                        Click="ClearButton_Click"/>
        </Grid>
    </Border>

</Grid>
</Window>